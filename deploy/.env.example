# Copy this file to deploy/.env and replace every change-me value.
#   cp .env.example .env
#   openssl rand -base64 24        # generate one secret per password line
#
# deploy/.env is git-ignored. Never commit real values and never reuse the
# placeholder text below.

# --- MySQL ----------------------------------------------------------------
# The database has no host port: only containers on the compose network reach it.
MYSQL_DATABASE=shiptrack
MYSQL_ROOT_PASSWORD=change-me-root

# DDL account: used only by the one-shot `migrate` service (Flyway).
# Must differ from DB_APP_USER, and the two passwords must differ too.
DB_MIGRATION_USER=shiptrack_migrate
DB_MIGRATION_PASSWORD=change-me-migration

# DML account: the only account the API uses at runtime.
DB_APP_USER=shiptrack_app
DB_APP_PASSWORD=change-me-app

# --- application ----------------------------------------------------------
# Bound to 127.0.0.1 only; publish it through the HTTPS reverse proxy instead.
APP_HOST_PORT=8080
APP_IMAGE_TAG=local
# Public API Bearer token (frontend login) and the collector-only token (§1.2).
API_TOKEN=change-me-api-token
INTERNAL_TOKEN=change-me-internal-token
# Daily scheduler is opt-in; the first M3 cut leaves it off.
SCHEDULER_ENABLED=false
TASK_CLAIM_TIMEOUT_MS=900000
# Passed to the JVM as JAVA_TOOL_OPTIONS. Keep the heap below the memory you
# give the container.
JAVA_TOOL_OPTIONS="-Xms256m -Xmx512m"
TZ=Asia/Shanghai

# --- web (nginx + built SPA) ----------------------------------------------
# Bound to 127.0.0.1 only, exactly like the API: publish it through the HTTPS
# reverse proxy instead of opening this port.
WEB_HOST_PORT=8088

# --- collector ------------------------------------------------------------
# The browser poller authenticates with INTERNAL_TOKEN above and never receives
# DB_* credentials: it reaches the API only over the compose network.
# How often to claim work; the first poll happens after a short fixed delay.
COLLECTOR_POLL_INTERVAL_MS=30000
# Heap for the collector JVM (Chromium runs in its own processes).
COLLECTOR_JAVA_TOOL_OPTIONS="-Xms128m -Xmx512m"
